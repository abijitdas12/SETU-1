# SETU Strategic Command System - Root Environment Reference
# Copy this file to .env or configure these variables in Render and Vercel

# ─────────────────────────────────────────────────────────────────────────────
# 1. Django Backend Environment Variables (Render Dashboard)
# ─────────────────────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=generate-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=setu-backend.onrender.com
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
CORS_ALLOWED_ORIGINS=https://setu-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://setu-frontend.vercel.app,https://setu-backend.onrender.com

# ─────────────────────────────────────────────────────────────────────────────
# 2. React Frontend Environment Variables (Vercel Dashboard)
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=https://setu-backend.onrender.com
